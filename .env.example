# BYO LLM — SiteAPI is a wrapper, not a model host.
# Any OpenAI-compatible /v1/chat/completions works.
# Local (Ollama first):
OPENAI_BASE_URL=http://127.0.0.1:11434/v1
OPENAI_API_KEY=ollama
OPENAI_MODEL=llama3.2

# Optional cloud: point OPENAI_BASE_URL at that host and set its key/model.
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini

# Browser capture
BROWSER_TIMEOUT_MS=20000

# Default cache TTL for published endpoints (5–3600)
CACHE_TTL_S=60

# Protects OUR published /v1/e/{slug} routes (not the LLM)
SITEAPI_API_KEY=dev-key-change-me

# Published /v1 rate limit per SITEAPI_API_KEY (0 = unlimited)
SITEAPI_RATE_LIMIT=60
SITEAPI_RATE_WINDOW_S=60

# Minimum gap between outbound fetches to the same host (robots.txt + capture)
HOST_GAP_MS=1000

# SQLite file (Drizzle). Relative to process cwd.
SITEAPI_DB_PATH=./data/siteapi.db

# Set to 1 only for sites you own, to skip robots.txt
SITEAPI_IGNORE_ROBOTS=0
